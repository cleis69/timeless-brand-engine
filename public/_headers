# Regles de cache pour les fichiers servis depuis public/.
#
# Sans ce fichier, Lovable/Cloudflare sert les posters, les SVG de marque
# et les videos SANS cache-control : chaque visite les retelecharge, et
# Lighthouse le compte comme 184 Ko gaspilles par visite.
#
# Le contenu de ces fichiers ne change qu'en changeant de nom de fichier
# (ou lors d'un remplacement volontaire), donc un cache long est sur.
# Une semaine, avec revalidation : assez pour que la deuxieme visite soit
# gratuite, assez court pour qu'un remplacement se propage vite.

/work/*
  cache-control: public, max-age=604800, stale-while-revalidate=86400

/brand/*
  cache-control: public, max-age=604800, stale-while-revalidate=86400

/favicon.ico
  cache-control: public, max-age=604800

/favicon.svg
  cache-control: public, max-age=604800

/favicon.png
  cache-control: public, max-age=604800

